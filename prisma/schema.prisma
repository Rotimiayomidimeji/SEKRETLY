generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // migrations need a direct (unpooled) connection; locally it is the same address as DATABASE_URL
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Phase 1: accounts, sessions and the codes for email checks.
// Phase 2: links (with quiz questions), the anonymous messages they receive, and per-day link stats.
// Phase 3: private chats, reports and the warning ladder, notifications, and inbox state (read/archived/deleted).
// Phase 3b: mystery features (sender hints, receipts, reactions, guess who), Kind mode, daily drops and streaks.
// Phase 4–6: report review, app settings, the visit log (admin traffic), game rooms and crews.

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum LinkTopic {
  DESCRIBE
  QUIZ
  CONFESS
  RATE
  AMA
  CUSTOM
  /// Today's drop: everyone gets the same daily question and shares their own link to it
  DROP
}

enum LinkStatus {
  LIVE
  PAUSED
  DELETED
}

model User {
  id               String             @id @default(cuid())
  /// Always stored lowercase; 3–20 letters, numbers or _.
  username         String             @unique
  passwordHash     String
  /// Null for accounts made from a link's "get replies" popup, which only confirm they are 16 or older.
  birthDate        DateTime?          @db.Date
  ageConfirmedAt   DateTime?
  /// The key in every link address (sekretlyy.vercel.app/<username>/<linkKey>/…). "Reset all" replaces it.
  linkKey          String             @unique
  /// Avatar picked at sign-up: fox, panda, frog, octopus, unicorn or koala.
  avatar           String             @default("fox")
  bio              String?
  role             Role               @default(MEMBER)
  status           UserStatus         @default(ACTIVE)
  /// Optional, only used to reset a forgotten password.
  recoveryEmail    String?
  emailVerifiedAt  DateTime?
  onboardedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastSeenAt       DateTime?
  /// Kind mode: 0 off (only threats held), 1 standard, 2 kind only
  kindMode         Int                @default(1)
  /// The member's own hidden words: messages containing them are held
  hiddenWords      String[]           @default([])
  /// Mystery features the member allows on their links
  allowHints       Boolean            @default(true)
  receiptReactions Boolean            @default(true)
  allowGuess       Boolean            @default(true)
  streakSaves      Int                @default(2)
  /// Last Monday a free streak save was added (1 a week, holding at most 2)
  savesToppedAt    DateTime?
  /// Up to 3 badge ids shown on the profile
  pinnedBadges     String[]           @default([])
  cloudPublic      Boolean            @default(true)
  /// Settings › Privacy: who can start private chats ("everyone" or "nobody"), whether visitors without an
  /// account can message, and whether the public profile (/u/<username>) is visible
  chatsFrom        String             @default("everyone")
  allowVisitors    Boolean            @default(true)
  publicProfile    Boolean            @default(true)
  /// Settings › Messages: how many days messages and chat bubbles last before they disappear
  inboxTimerDays   Int                @default(1)
  chatTimerDays    Int                @default(1)
  /// Settings › Safety: photos and videos stay blurred until tapped
  blurMedia        Boolean            @default(true)
  /// Settings › Notifications: which pushes to send ({ msg, reply, join, turn, paused, warn, drop, streak, wrap, quiet })
  notifPrefs       Json?
  /// Settings › Games
  gameInvites      Boolean            @default(true)
  gameListing      Boolean            @default(true)
  pushSubs         PushSubscription[]
  sessions         Session[]
  codes            EmailCode[]
  links            Link[]
  received         Message[]          @relation("received")
  sent             Message[]          @relation("sent")
  guessesMade      Guess[]            @relation("guesser")
  streakSavesUsed  StreakSave[]
  chatsOwned       Chat[]             @relation("chatOwner")
  chatsJoined      Chat[]             @relation("chatGuest")
  notifications    Notification[]
  reportsMade      Report[]
}

/// One shareable link: a topic in a theme. Address: /<username>/<owner's linkKey>/<theme>/<slug>.
model Link {
  id             String         @id @default(cuid())
  ownerId        String
  topic          LinkTopic
  /// describe-3, know-me, confess, rate-me, ama, or c-xxxx for a custom question
  slug           String
  theme          String
  customQuestion String?
  /// For DROP links: the drop number (one question per day for everyone) and the owner's own answer, if shared
  dropNumber     Int?
  dropSelf       String?
  /// Per-link overrides set when making a drop: Kind mode on/off and whether senders may leave hints
  kindOff        Boolean        @default(false)
  hintsOff       Boolean        @default(false)
  /// Optional limits: the link naps after this many messages, or at this time.
  maxMessages    Int?
  closesAt       DateTime?
  status         LinkStatus     @default(LIVE)
  messageCount   Int            @default(0)
  visitCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]
  messages       Message[]
  days           LinkDay[]

  @@unique([ownerId, theme, slug])
  @@index([ownerId, status])
}

/// "How well do you know me?" questions, in order.
model QuizQuestion {
  id           String   @id @default(cuid())
  linkId       String
  position     Int
  text         String
  options      String[]
  correctIndex Int
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, position])
}

/// An anonymous message sent through a link. `data` holds topic details:
/// describe { words }, rate { score, category }, quiz { score, of, nickname, picks }.
model Message {
  id                String    @id @default(cuid())
  linkId            String
  recipientId       String
  topic             LinkTopic
  text              String
  data              Json?
  mediaUrl          String?
  /// Set when the sender has an account (needed for replies); never shown to the recipient.
  senderId          String?
  /// Hashed network + browser of the sender, for spam limits and (later) the warning ladder. Never the raw IP.
  senderFingerprint String
  wantsReply        Boolean   @default(false)
  /// Coarse "who sent this" hint the recipient can unlock: city · device · time of day. Never exact.
  hint              String?
  /// The sender's own optional clue ("we met this year"). Names, numbers and @handles are stripped.
  senderHint        String?
  /// Lets an anonymous sender check what happened to their message (SK-XXXX-XX). Only this code links back.
  receiptCode       String?   @unique
  /// The recipient's reaction (0 love it, 1 laughing, 2 shook, 3 secret safe, 4 touched)
  reaction          Int?
  reactedAt         DateTime?
  /// Kind mode held this for review instead of delivering it (the reason), until released
  held              String?
  releasedAt        DateTime?
  /// A follow-up the sender added from their receipt
  followUpOfId      String?
  readAt            DateTime?
  archivedAt        DateTime?
  /// Deleted by the recipient. Kept (hidden) until it expires so reports about it still count.
  deletedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  link              Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  recipient         User      @relation("received", fields: [recipientId], references: [id], onDelete: Cascade)
  sender            User?     @relation("sent", fields: [senderId], references: [id], onDelete: SetNull)
  chat              Chat?
  guesses           Guess[]

  @@index([recipientId, createdAt])
  @@index([linkId, createdAt])
}

/// Visits and messages per link per day, for the insights chart, and where visits came from
/// (detected from the referrer and in-app browser; counts only, nothing about who).
model LinkDay {
  linkId        String
  day           DateTime @db.Date
  visits        Int      @default(0)
  messages      Int      @default(0)
  fromWhatsapp  Int      @default(0)
  fromInstagram Int      @default(0)
  fromSnapchat  Int      @default(0)
  fromOther     Int      @default(0)
  link          Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, day])
}

/// Devices that have sent a message before (hashed). First-timers see the "get replies" popup; returning ones get a toggle.
model Visitor {
  fingerprint String   @id
  firstSeenAt DateTime @default(now())
}

/// A private, anonymous chat the recipient ("owner") starts from a message whose sender has an account ("guest").
/// The owner sees the guest only as `alias`; the guest sees the owner's username (they messaged their link).
model Chat {
  id              String        @id @default(cuid())
  messageId       String        @unique
  ownerId         String
  guestId         String
  alias           String
  aliasAvatar     String
  lastAt          DateTime      @default(now())
  ownerReadAt     DateTime?
  guestReadAt     DateTime?
  ownerArchivedAt DateTime?
  guestArchivedAt DateTime?
  ownerDeletedAt  DateTime?
  guestDeletedAt  DateTime?
  createdAt       DateTime      @default(now())
  message         Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  owner           User          @relation("chatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guest           User          @relation("chatGuest", fields: [guestId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]

  @@index([ownerId, lastAt])
  @@index([guestId, lastAt])
}

/// One bubble in a chat. Disappears a day after it is sent, like every message.
model ChatMessage {
  id             String   @id @default(cuid())
  chatId         String
  fromOwner      Boolean
  text           String?
  mediaUrl       String?
  /// photo or video
  mediaKind      String?
  deletedByOwner Boolean  @default(false)
  deletedByGuest Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

/// "Guess who": the recipient names who they think sent a message. A right guess asks the sender privately;
/// they choose to reveal or not. Wrong guesses resolve as "not confirmed" after a while, so timing gives nothing away.
model Guess {
  id            String   @id @default(cuid())
  messageId     String
  guesserId     String
  guessedUserId String
  correct       Boolean
  /// PENDING until the sender decides (right guesses) or until resolveAt passes (wrong ones); then REVEALED or HIDDEN
  status        String   @default("PENDING")
  resolveAt     DateTime
  createdAt     DateTime @default(now())
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  guesser       User     @relation("guesser", fields: [guesserId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([guessedUserId, status])
}

/// A streak save spent on a missed drop day.
model StreakSave {
  userId     String
  dropNumber Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dropNumber])
}

/// A report a recipient made about something sent to them.
model Report {
  id            String    @id @default(cuid())
  reporterId    String
  /// "u:<userId>" for account holders, "f:<fingerprint>" for anonymous senders
  senderKey     String
  messageId     String?
  chatMessageId String?
  category      String
  /// What was reported, copied so moderators can still see it after the message disappears.
  excerpt       String
  /// Admin review of serious reports: keep, reverse (warning undone), suspend (sender suspended), escalate
  decision      String?
  decidedAt     DateTime?
  decidedBy     String?
  createdAt     DateTime  @default(now())
  reporter      User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId, senderKey])
  @@index([createdAt])
}

/// How a sender stands with one recipient: each report is a warning; the 4th blocks them from that recipient only.
/// Undoing a block puts them back on 3 warnings, so the next report blocks again.
model SenderStanding {
  recipientId String
  senderKey   String
  warns       Int       @default(0)
  blockedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@id([recipientId, senderKey])
}

enum NotificationKind {
  MESSAGE
  REPLY
  WARNING
  BLOCKED
  BLOCKED_SENDER
  SUPPORT
  LINK_NAP
  WELCOME
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String           @default("")
  href      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A browser or phone that agreed to push notifications (Web Push). Removed when the push service says it's gone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// App-wide switches the admin changes (report categories, ad slots, blocked networks), one JSON value per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One request worth showing on Admin › Traffic (link visits, sends, sign-ups). Kept 30 days.
model VisitLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  kind        String
  path        String
  fingerprint String
  ip          String
  city        String?
  region      String?
  country     String?
  device      String
  os          String
  browser     String
  userId      String?

  @@index([at])
  @@index([ip])
}

/// A game table: made by a host (Create game), joined by code or link, played live by everyone in it.
model GameRoom {
  id         String       @id @default(cuid())
  code       String       @unique
  game       String
  name       String
  hostId     String
  status     String       @default("LOBBY")
  isPublic   Boolean      @default(false)
  maxPlayers Int          @default(6)
  settings   Json
  /// the live table, advanced by the host's actions and every player's answers
  state      Json?
  version    Int          @default(0)
  startsAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  players    GamePlayer[]

  @@index([status, isPublic])
}

model GamePlayer {
  id         String    @id @default(cuid())
  roomId     String
  userId     String?
  nick       String
  color      String
  isHost     Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  kickedAt   DateTime?
  room       GameRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, nick])
  @@index([userId])
}

/// Friends saved from a game table.
model Crew {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  /// game night, RSVPs, inside jokes and the daily crew question with its votes
  data      Json         @default("{}")
  createdAt DateTime     @default(now())
  members   CrewMember[]
}

model CrewMember {
  crewId   String
  userId   String
  joinedAt DateTime @default(now())
  crew     Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@id([crewId, userId])
  @@index([userId])
}

/// One logged-in device. The cookie holds a random token; only its SHA-256 hash is stored here.
model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A 6-digit code sent by email (hashed). Expires after 10 minutes; 5 wrong tries uses it up.
model EmailCode {
  id        String      @id @default(cuid())
  userId    String
  purpose   CodePurpose
  email     String
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Counters for rate limits (login tries, sign-ups, code requests). Works across serverless instances.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
