# PostgreSQL connection strings used by Prisma. On Vercel (Neon) DATABASE_URL is the pooled address and
# DATABASE_URL_UNPOOLED the direct one (used for migrations). Locally both are the same.
DATABASE_URL=postgresql://postgres:password@localhost:5432/sekretly
DATABASE_URL_UNPOOLED=postgresql://postgres:password@localhost:5432/sekretly

# Generate a long random secret before enabling authentication.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Public origin of the application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for scheduled pushes (/api/cron/*); Vercel sends it as a Bearer token
CRON_SECRET=

# Web push keys (npx web-push generate-vapid-keys); the public one is used by the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Product analytics (optional): PostHog project key and host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google AdSense publisher id (ca-pub-…). Ads also need Admin › Ads switched on.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Vercel Blob store token, for photos and videos. Without it (local dev) files are kept in .data/media.
BLOB_READ_WRITE_TOKEN=

# Resend, for password-reset and recovery-email codes. Without it the code is printed in the dev terminal.
RESEND_API_KEY=
EMAIL_FROM=Sekretly <onboarding@resend.dev>
